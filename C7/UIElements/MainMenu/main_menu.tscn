[node name="GameIntro" type="RichTextLabel" parent="Control/Background/MarginContainer/PanelContainer2/MarginContainer/RightSidebar"]
layout_mode = 2
theme_override_colors/font_shadow_color = Color(0, 0, 0, 1)
bbcode_enabled = true
text = "[b]OpenCiv3[/b] is an open-source, cross-platform, mod-oriented, modernized reimagining of [i]Civilization III[/i] by the fan community built with the Godot Engine and C#, with capabilities inspired by the best of the 4X genre and lessons learned from modding Civ3.

Our vision is to make Civ3 as it could have been, rebuilt for today’s modders and players: removing arbitary limits, fixing broken features, expanding mod capabilities, and supporting modern graphics and platforms.

"
fit_content = true

